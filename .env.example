# Postgres connection string (Supabase / Neon / any managed Postgres)
DATABASE_URL="postgresql://user:password@host:5432/teamslots"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Enable "Google Calendar API" for the project, and add this redirect URI:
#   http://localhost:3000/api/auth/callback/google   (and your prod URL later)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (https://resend.com) for confirmation emails
# Gmail SMTP, for sending confirmation emails — uses the organizer's own
# Gmail account via an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords). Free, and can send to any recipient,
# unlike Resend's free tier without a verified custom domain (which can
# only deliver to the account owner's own inbox).
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=""
